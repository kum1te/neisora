{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "neisora",
  "version": "1.0.0",
  "identifier": "local.kumite.vesper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "neisora",
        "width": 1360,
        "height": 860,
        "minWidth": 420,
        "minHeight": 440,
        "decorations": false,
        "backgroundColor": "#0c0d10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://*.googleusercontent.com https://*.ggpht.com https://*.ytimg.com https://*.youtube.com https://cdn-images.dzcdn.net; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Music",
    "publisher": "kum1te",
    "license": "GPL-3.0-only",
    "shortDescription": "YouTube Music with a custom desktop interface",
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "depends": [
          "mpv (>= 0.34.0)",
          "libdbus-1-3",
          "python3 (>= 3.10)"
        ],
        "recommends": [
          "imagemagick"
        ],
        "files": {
          "/usr/share/doc/neisora/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "depends": [
          "gtk3",
          "dbus-libs",
          "webkit2gtk4.1",
          "mpv",
          "python3"
        ],
        "recommends": [
          "ImageMagick"
        ],
        "compression": {
          "type": "zstd",
          "level": 10
        }
      }
    }
  }
}
